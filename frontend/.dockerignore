# Dependencies (re-installed inside container)
node_modules/
.pnp
.pnp.*
.yarn/

# Build output (built fresh inside container)
.next/
out/
dist/

# Tests / fixtures (not needed in production image). tests/ itself stays in the
# build context: component *.test.tsx files import @/tests/intl-test-utils and
# `next build` type-checks them. Nothing here ships — the runner stage copies
# only .next/standalone, .next/static and public/.
tests/e2e/
playwright-report/
test-results/

# Editor / OS
.idea/
.vscode/
*.swp
.DS_Store

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Env files (secrets injected at runtime via k8s Secret, not baked into image)
.env*

# Git / Docker / CI
.git/
.gitignore
.gitattributes
Dockerfile
.dockerignore

# Coverage
coverage/
